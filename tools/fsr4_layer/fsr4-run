#!/bin/bash
# Run a game with tuned FSR4 shaders.
#
# Steam:   put this in the launch options of the game
#              /path/to/fsr4-run %command%
# Heroic:  Settings, Advanced, Wrapper command, add
#              /path/to/fsr4-run
# Anything else: just put it in front of the command.
#
# Environment:
#   FSR4_SET      which shader set to use. Default: balanced
#                 Four names cover the common cases:
#                   lossless   = exact, the same maths, only faster where baking wins
#                   quality    = fin15, hard to tell from stock
#                   balanced   = fin25, clearly faster, very close to stock
#                   speed      = prune16, fastest, visibly softer
#                 Everything measured is available by its own name. Run with FSR4_SET=list to see
#                 them, and read the table in README.md before picking.
#                 off        replace no shaders, but still rewrite the packed dot products
#                 none       do not load the layer at all
#   FSR4_SETS     directory holding the sets. Default: the sets/ next to this script
#   FSR4_LAYER    directory holding libfsr4_layer.so and fsr4_layer.json. Default: next to this script
#   FSR4_CACHE    where the layer looks for shaders. Default ~/.cache/fsr4_opt/spirv
#   FSR4_DEBUG    1 prints one line per replaced shader
#
# The layer only replaces shaders it has a tuned version of, and falls back to the game's own
# whenever the driver rejects one, so a wrong set cannot break a game.
set -u
HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
SET=${FSR4_SET:-balanced}
SETS=${FSR4_SETS:-$HERE/sets}
LAYER=${FSR4_LAYER:-$HERE}
CACHE=${FSR4_CACHE:-$HOME/.cache/fsr4_opt/spirv}

if [ "$SET" = list ]; then
    echo "sets in $SETS:" >&2
    ls "$SETS" 2>/dev/null | grep -v '^keys\.txt$' | tr '\n' ' ' >&2
    echo >&2
    echo "aliases: lossless=exact quality=fin15 balanced=fin25 speed=prune16" >&2
    echo "off replaces nothing, none disables the layer" >&2
    echo "see SETS.md next to this script, or docs/SETS.md in the repository" >&2
    exit 0
fi

# none takes the layer out of the picture. off keeps it, because the layer also rewrites FSR4's
# packed dot products for cards that have no hardware instruction for them, and that is a pure win.
if [ "$SET" = none ] || [ $# -eq 0 ]; then
    exec "$@"
fi

case "$SET" in
    lossless) SET=exact ;;
    quality)  SET=fin15 ;;
    balanced) SET=fin25 ;;
    speed)    SET=prune16 ;;
esac

if [ "$SET" != off ] && [ ! -d "$SETS/$SET" ]; then
    echo "fsr4-run: no set '$SET' in $SETS. Available: $(ls "$SETS" 2>/dev/null | grep -v '^keys\.txt$' | tr '\n' ' ')" >&2
    exec "$@"
fi

if [ "$SET" = off ]; then
    echo "fsr4-run: no shader replacement, dot product rewrite only" >&2
else
    echo "fsr4-run: set '$SET', $(ls "$SETS/$SET" | wc -l) shaders" >&2
fi

if [ ! -f "$LAYER/libfsr4_layer.so" ]; then
    echo "fsr4-run: $LAYER/libfsr4_layer.so is missing. Build it with:" >&2
    echo "  gcc -O2 -fPIC -shared -o $LAYER/libfsr4_layer.so $LAYER/fsr4_layer.c -lpthread" >&2
    exec "$@"
fi

# The loader resolves library_path relative to the json, and some loaders only accept an absolute
# path, so write a manifest that carries one.
MANIFEST=$(mktemp -d)
sed "s|\"library_path\":.*|\"library_path\": \"$LAYER/libfsr4_layer.so\",|" \
    "$LAYER/fsr4_layer.json" > "$MANIFEST/fsr4_layer.json"

export VK_LAYER_PATH="$MANIFEST"
export VK_INSTANCE_LAYERS=VK_LAYER_FSR4_tune
export FSR4_SET="$SET"
export FSR4_SETS="$SETS"
[ "${FSR4_DEBUG:-0}" = 1 ] && export FSR4_LAYER_DEBUG=1

# vkd3d-proton serves pipelines from its own cache without ever handing SPIR-V to the driver, and the
# layer can only replace what it sees, so that path has to be switched off.
if [ -n "${VKD3D_CONFIG:-}" ]; then
    export VKD3D_CONFIG="$VKD3D_CONFIG,pipeline_library_ignore_spirv"
else
    export VKD3D_CONFIG=pipeline_library_ignore_spirv
fi

exec "$@"
