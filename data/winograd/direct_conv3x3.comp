#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
// Direct 3x3 convolution, int8 inputs, using the same pair-wise 16-bit MAD decomposition
// the shipped dxil-spirv patch emits (mad16 mode). Produces 4 outputs per iteration
// (a 2x2 output tile) = 36 MACs, so it is directly comparable to Winograd F(2x2,3x3).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer InA { uint a[]; };
layout(std430, binding = 1) readonly buffer InB { uint b[]; };
layout(std430, binding = 2) writeonly buffer Out { int outv[]; };
layout(push_constant) uniform PC { uint iterations; } pc;

int16_t bs(uint p, uint l) { int v = int((p >> (l*8u)) & 0xFFu); return int16_t((v << 24) >> 24); }

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint pa = a[idx], pb = b[idx];
    int acc = 0;
    for (uint it = 0u; it < pc.iterations; ++it) {
        uint xa = pa ^ it;
        uint xb = pb ^ (it * 2654435761u);
        // 4 output pixels x 9 taps = 36 MACs, accumulated pairwise in 16-bit
        for (int o = 0; o < 4; ++o) {
            int16_t s = int16_t(0);
            for (int t = 0; t < 9; t += 2) {
                int16_t p0 = int16_t(bs(xa, uint((t+o) & 3)) * bs(xb, uint(t & 3)));
                int16_t p1 = int16_t(bs(xa, uint((t+1+o) & 3)) * bs(xb, uint((t+1) & 3)));
                s = int16_t(s + p0);
                acc += int(s);
                s = int16_t(p1);
            }
            acc += int(s);
        }
    }
    outv[idx] = acc;
}
