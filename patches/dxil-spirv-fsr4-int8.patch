+// Returns true if value is provably in [-128, 127] (an 8-bit field extract).
+static bool value_is_8bit_bfe(const llvm::Value *value)
+{
+	auto *call = llvm::dyn_cast<llvm::CallInst>(value);
+	if (!call)
+		return false;
+	auto *fn = call->getCalledFunction();
+	if (!fn || strncmp(fn->getName().data(), "dx.op", 5) != 0)
+		return false;
+
+	uint32_t opcode = 0;
+	if (!get_constant_operand(call, 0, &opcode))
+		return false;
+	if (opcode != unsigned(DXIL::Op::Ibfe) && opcode != unsigned(DXIL::Op::Ubfe))
+		return false;
+
+	uint32_t width = 0;
+	return get_constant_operand(call, 1, &width) && width == 8;
+}
+
+// GFX8 (Polaris/GCN4) has 16-bit integer ALU but no packed/dual-issue 16-bit math,
+// so i16 arithmetic is the same rate as i32 while additionally paying for the
+// narrowing/widening conversions around it. The FSR4 INT8 model's shaders decompose
+// every int8 MAC into 7 SPIR-V ops:
+//   bfe(w,8); bfe(a,8); trunc->i16 (x2); mul i16; sext->i32; add i32
+// Both bfe results are 8-bit sign-extended (|v| <= 128), so |product| <= 16384 --
+// which fits losslessly in BOTH i16 and i32. The trunc/mul-i16/sext chain is
+// therefore exactly equivalent to a single 32-bit multiply of the pre-trunc values,
+// collapsing 5 ops into 1 (7 -> 3 per MAC). The now-unused i16 ops are dead and are
+// removed by NIR/ACO's DCE. Fires only on this exact verified shape, so unrelated
+// 16-bit arithmetic in normal rendering shaders is untouched.
+static spv::Id try_peephole_widen_i16_mul(Converter::Impl &impl, const llvm::CastInst *instruction)
+{
+	static unsigned n_sext = 0, n_mul = 0, n_trunc = 0, n_bfe = 0, n_hit = 0;
+
+	if (instruction->getOpcode() != llvm::Instruction::CastOps::SExt)
+		return 0;
+
+	auto *dst_type = instruction->getType();
+	auto *src_type = instruction->getOperand(0)->getType();
+	if (!dst_type->isIntegerTy() || dst_type->getIntegerBitWidth() != 32)
+		return 0;
+	if (!src_type->isIntegerTy() || src_type->getIntegerBitWidth() != 16)
+		return 0;
+	n_sext++;
+
+	auto *mul = llvm::dyn_cast<llvm::BinaryOperator>(instruction->getOperand(0));
+	if (!mul || llvm::Instruction::BinaryOps(mul->getOpcode()) != llvm::BinaryOperator::BinaryOps::Mul)
+	{
+		if (n_sext <= 4)
+			fsr4dbg("widen_i16_mul: sext#%u operand is not a Mul\n", n_sext);
+		return 0;
+	}
+	n_mul++;
+
+	const llvm::Value *src[2] = {};
+	for (unsigned i = 0; i < 2; i++)
+	{
+		auto *tr = llvm::dyn_cast<llvm::CastInst>(mul->getOperand(i));
+		if (!tr || tr->getOpcode() != llvm::Instruction::CastOps::Trunc)
+		{
+			if (n_mul <= 4)
+				fsr4dbg("widen_i16_mul: mul#%u operand %u is not a Trunc\n", n_mul, i);
+			return 0;
+		}
+		auto *pre = tr->getOperand(0);
+		if (!pre->getType()->isIntegerTy() || pre->getType()->getIntegerBitWidth() != 32)
+			return 0;
+		src[i] = pre;
+	}
+	n_trunc++;
+
+	for (unsigned i = 0; i < 2; i++)
+	{
+		if (!value_is_8bit_bfe(src[i]))
+		{
+			if (n_trunc <= 4)
+				fsr4dbg("widen_i16_mul: trunc#%u src %u is not an 8-bit bfe\n", n_trunc, i);
+			return 0;
+		}
+	}
+	n_bfe++;
+
+	auto *op = impl.allocate(spv::OpIMul, instruction);
+	op->add_id(impl.get_id_for_value(src[0]));
+	op->add_id(impl.get_id_for_value(src[1]));
+	impl.add(op);
+
+	n_hit++;
+	if (n_hit <= 3 || (n_hit % 5000) == 0)
+		fsr4dbg("widen_i16_mul HIT #%u (sext=%u mul=%u trunc=%u bfe=%u)\n", n_hit, n_sext, n_mul, n_trunc, n_bfe);
+	return op->id;
+}
