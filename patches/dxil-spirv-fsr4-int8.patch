+// GFX8 note: RADV/ACO has no native packed/double-rate int16 multiply on GCN4,
+// but native fp32 FMA/FMul is meaningfully faster (measured ~11-13% in isolation)
+// than the scalar int16 domain for exactly this pattern: two DXIL Ibfe/Ubfe(width=8)
+// byte-extractions truncated to i16, then multiplied. This shows up heavily in the
+// real FSR4 int8 model's shaders (tens of thousands of instances per shader), since
+// it manually decomposes packed-int8 dot products this way instead of using DXIL's
+// Dot4AddI8Packed/U8Packed intrinsic (which this DLL never emits at all).
+// Only fires for this exact, narrowly-verified pattern -- never touches unrelated
+// 16-bit arithmetic, so it can't affect normal rendering shaders.
+static bool is_bfe8_trunc_operand(const llvm::Value *value, bool &sign_extend)
+{
+	auto *cast = llvm::dyn_cast<llvm::CastInst>(value);
+	if (!cast || cast->getOpcode() != llvm::Instruction::CastOps::Trunc)
+		return false;
+
+	auto *call = llvm::dyn_cast<llvm::CallInst>(cast->getOperand(0));
+	if (!call)
+		return false;
+
+	auto *called_function = call->getCalledFunction();
+	if (!called_function || strncmp(called_function->getName().data(), "dx.op", 5) != 0)
+		return false;
+
+	uint32_t opcode = 0;
+	if (!get_constant_operand(call, 0, &opcode))
+		return false;
+	if (opcode != unsigned(DXIL::Op::Ibfe) && opcode != unsigned(DXIL::Op::Ubfe))
+		return false;
+
+	uint32_t width = 0;
+	if (!get_constant_operand(call, 1, &width) || width != 8)
+		return false;
+
+	sign_extend = (opcode == unsigned(DXIL::Op::Ibfe));
+	return true;
+}
+
+template <typename InstructionType>
+static spv::Id try_peephole_int8_mul_fp32(Converter::Impl &impl, const InstructionType *instruction)
+{
+	auto *type = instruction->getType();
+	if (!type->isIntegerTy())
+		return 0;
+	{
+		static unsigned fsr4debug_width_hist[65] = {};
+		static unsigned fsr4debug_width_total = 0;
+		unsigned w = type->getIntegerBitWidth();
+		if (w < 65)
+			fsr4debug_width_hist[w]++;
+		fsr4debug_width_total++;
+		if ((fsr4debug_width_total % 2000) == 1)
+		{
+			LOGE("FSR4DEBUG mul width histogram (total=%u):\n", fsr4debug_width_total);
+			for (unsigned i = 0; i < 65; i++)
+				if (fsr4debug_width_hist[i] > 0)
+					LOGE("FSR4DEBUG   width=%u count=%u\n", i, fsr4debug_width_hist[i]);
+		}
+	}
+	if (type->getIntegerBitWidth() != 16)
+		return 0;
+
+	{
+		static unsigned fsr4debug_op0_cast = 0, fsr4debug_op0_trunc = 0, fsr4debug_op0_call = 0;
+		static unsigned fsr4debug_op0_dxop = 0, fsr4debug_op0_bfeop = 0, fsr4debug_op0_width8 = 0;
+		static unsigned fsr4debug_seen16 = 0;
+		fsr4debug_seen16++;
+		auto *cast = llvm::dyn_cast<llvm::CastInst>(instruction->getOperand(0));
+		if (cast)
+		{
+			fsr4debug_op0_cast++;
+			if (cast->getOpcode() == llvm::Instruction::CastOps::Trunc)
+			{
+				fsr4debug_op0_trunc++;
+				auto *call = llvm::dyn_cast<llvm::CallInst>(cast->getOperand(0));
+				if (call)
+				{
+					fsr4debug_op0_call++;
+					auto *fn = call->getCalledFunction();
+					if (fn && strncmp(fn->getName().data(), "dx.op", 5) == 0)
+					{
+						fsr4debug_op0_dxop++;
+						uint32_t opc = 0;
+						if (get_constant_operand(call, 0, &opc) &&
+						    (opc == unsigned(DXIL::Op::Ibfe) || opc == unsigned(DXIL::Op::Ubfe)))
+						{
+							fsr4debug_op0_bfeop++;
+							uint32_t width = 0;
+							if (get_constant_operand(call, 1, &width) && width == 8)
+								fsr4debug_op0_width8++;
+						}
+					}
+				}
+			}
+		}
+		if ((fsr4debug_seen16 % 200) == 1)
+		{
+			LOGE("FSR4DEBUG i16mul seen=%u op0_cast=%u op0_trunc=%u op0_call=%u op0_dxop=%u op0_bfeop=%u op0_width8=%u\n",
+			     fsr4debug_seen16, fsr4debug_op0_cast, fsr4debug_op0_trunc, fsr4debug_op0_call,
+			     fsr4debug_op0_dxop, fsr4debug_op0_bfeop, fsr4debug_op0_width8);
+		}
+	}
+
+	bool sign_a = false, sign_b = false;
+	if (!is_bfe8_trunc_operand(instruction->getOperand(0), sign_a))
+		return 0;
+	if (!is_bfe8_trunc_operand(instruction->getOperand(1), sign_b))
+		return 0;
+	if (sign_a != sign_b)
+		return 0;
+
+	{
+		static unsigned fsr4debug_hitcount = 0;
+		fsr4debug_hitcount++;
+		if ((fsr4debug_hitcount % 50) == 1)
+			LOGE("FSR4DEBUG int8_mul_fp32 peephole hit #%u\n", fsr4debug_hitcount);
+	}
+
+	auto &builder = impl.builder();
+	spv::Id float_type = builder.makeFloatType(32);
+	spv::Id i16_type = sign_a ? builder.makeIntType(16) : builder.makeUintType(16);
+	spv::Op to_float_op = sign_a ? spv::OpConvertSToF : spv::OpConvertUToF;
+	spv::Op to_int_op = sign_a ? spv::OpConvertFToS : spv::OpConvertFToU;
+
+	spv::Id a_id = impl.get_id_for_value(instruction->getOperand(0));
+	spv::Id b_id = impl.get_id_for_value(instruction->getOperand(1));
+
+	auto *a_f = impl.allocate(to_float_op, float_type);
+	a_f->add_id(a_id);
+	impl.add(a_f);
+
+	auto *b_f = impl.allocate(to_float_op, float_type);
+	b_f->add_id(b_id);
+	impl.add(b_f);
+
+	auto *mul_f = impl.allocate(spv::OpFMul, float_type);
+	mul_f->add_id(a_f->id);
+	mul_f->add_id(b_f->id);
+	impl.add(mul_f);
+
+	auto *result = impl.allocate(to_int_op, i16_type);
+	result->add_id(mul_f->id);
+	impl.add(result);
+
+	return result->id;
+}
