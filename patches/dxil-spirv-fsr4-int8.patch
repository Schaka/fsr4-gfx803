+// Direct-to-file diagnostics. dxil-spirv's LOGE routes through a thread-local
+// callback into vkd3d's SHADER debug channel, which is filtered out in practice,
+// so shader-translation instrumentation is otherwise invisible.
+static void fsr4dbg(const char *fmt, ...)
+{
+	static FILE *f = nullptr;
+	static bool tried = false;
+	if (!tried)
+	{
+		tried = true;
+		if (!getenv("FSR4_DEBUG_FILE")) { f = nullptr; return; }
+		const char *paths[] = { "Z:/data/tmp/fsr4dbg.txt", "Z:\\data\\tmp\\fsr4dbg.txt", "fsr4dbg.txt", "C:/fsr4dbg.txt" };
+		for (unsigned pi = 0; pi < 4 && !f; pi++)
+			f = fopen(paths[pi], "w");
+	}
+	if (!f)
+		return;
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fflush(f);
+}
