+		if (strcmp(env, "mad16") == 0)
+			return Fsr4DotMode::Mad16;
+		if (strcmp(env, "vec16") == 0)
+			return Fsr4DotMode::Vec16;
+		if (strcmp(env, "i32") == 0)
+			return Fsr4DotMode::I32;
+		return Fsr4DotMode::Mad16;
+	}();
