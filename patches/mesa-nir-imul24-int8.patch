+/** Is value a constant that fits in signed 24 bits? */
+static inline bool
+is_s24(UNUSED const nir_search_state *state, const nir_alu_instr *instr,
+       unsigned src, unsigned num_components,
+       const uint8_t *swizzle)
+{
+   /* only constant srcs: */
+   if (!nir_src_is_const(instr->src[src].src))
+      return false;
+
+   for (unsigned i = 0; i < num_components; i++) {
+      const int64_t val = nir_src_comp_as_int(instr->src[src].src, swizzle[i]);
+      if (val < INT64_C(-8388608) || val > INT64_C(8388607))
+         return false;
+   }
+
+   return true;
+}
+
+/** Is value a constant that fits in unsigned 24 bits? */
+static inline bool
+is_u24(UNUSED const nir_search_state *state, const nir_alu_instr *instr,
+       unsigned src, unsigned num_components,
+       const uint8_t *swizzle)
+{
+   return is_ult(instr, src, num_components, swizzle, 0x1000000u);
+}
+
